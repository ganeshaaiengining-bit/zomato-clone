{
  "name": "foodiezone",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FoodieZone — food delivery web app (Zomato-style) built with React + Vite + Firebase",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "emulators": "firebase emulators:start",
    "seed": "node scripts/seed-firestore.mjs",
    "create-admin": "node scripts/create-admin.mjs",
    "report": "node scripts/report.mjs",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-tools": "^15.31.0",
    "globals": "^17.12.0",
    "vite": "^8.3.1"
  }
}
