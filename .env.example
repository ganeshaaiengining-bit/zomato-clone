# -----------------------------------------------------------------------------
# Firebase Web App config
# Firebase console > Project settings > General > Your apps > SDK setup
#   1. Firebase me ek "Web App" add karein
#   2. Neeche diye gaye values copy karein
#   3. Is file ko `.env` naam se copy karein:  cp .env.example .env
#   4. `npm run dev` dobara chalayein
#
# NOTE: .env me jo keys hain wo "public" hain (client SDK me hoti hi hain).
# Security rules (firestore.rules / storage.rules) hi asli protection hain.
# -----------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Optional: admin email(s) jinke liye /admin page allow hai (comma separated).
# Khali chhodne par koi bhi logged-in user admin nahi hoga.
VITE_ADMIN_EMAILS=admin@foodiezone.app
